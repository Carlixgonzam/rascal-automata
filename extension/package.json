{
  "name": "automata",
  "displayName": "Automata",
  "description": "A language for finite automata and regular expressions, with a live view of each automaton.",
  "version": "0.1.0",
  "publisher": "automata",
  "license": "BSD-2-Clause",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Programming Languages", "Education"],
  "activationEvents": ["onLanguage:automata"],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "automata",
        "aliases": ["Automata"],
        "extensions": [".auto"],
        "configuration": "./assets/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "automata",
        "scopeName": "source.automata",
        "path": "./assets/automata.tmGrammar.json"
      }
    ]
  },
  "scripts": {
    "jar": "cd .. && mvn -q package -DskipTests && cp target/rascal-automata-*.jar extension/assets/jars/automata.jar",
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "package": "npm run jar && webpack --mode production --devtool hidden-source-map",
    "vsix": "npm run package && vsce package --no-dependencies"
  },
  "dependencies": {
    "@usethesource/rascal-vscode-dsl-lsp-server": "0.13.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "copy-webpack-plugin": "^12.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.4.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0"
  }
}
