{
    "scopeName": "source.automata",
    "name": "Automata",
    "patterns": [
        { "name": "comment.line.double-slash.automata", "match": "//.*$" },
        { "name": "string.quoted.double.automata", "match": "\"[A-Za-z0-9]*\"" },
        { "name": "keyword.control.automata", "match": "\\b(dfa|nfa|pda|tm|grammar|regex|over|start|final|run|show|check|in)\\b" },
        { "name": "support.function.automata", "match": "\\b(determinize|minimize|complement|union|intersection|difference|rename|push|pop|ignore|skip|changeTop|pushOn)\\b" },
        { "name": "constant.language.automata", "match": "λ|ε|∅|\\blambda\\b" },
        { "name": "keyword.operator.automata", "match": "->|-|\\||\\*|\\+|\\?" }
    ]
}
