tm anbn_simplified
  start 5
  0: W[N]
  1: W[Y]
  2: W[x]L[#]
  3: W[x]
  4: R
  5: R
  2 -> 5
  3 -> 4
  4 -#-> 0
  4 -b-> 2
  4 -a,x-> 4
  5 -b-> 0
  5 -#-> 1
  5 -a-> 3
  5 -x-> 5

tm anbncn_simplified
